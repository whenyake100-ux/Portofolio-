<style>
/* Layout: layar menu game. Header, hero kiri + kartu pemain kanan, lalu tentang, skill, kontak.
   Semua kotak bersudut siku dengan bayangan keras, seperti tombol di konsol lama. */
:root {
  --bg: #F4F7FB;
  --surface: #FFFFFF;
  --ink: #101B2D;
  --muted: #475672;
  --accent: #2457F5;
  --accent-ink: #FFFFFF;
  --coin: #FFC83D;
  --line: #101B2D;
  --shadow: #101B2D;
  --logo-bg: #FFFFFF;
  --grid: rgba(36, 87, 245, 0.1);
  --glow-a: rgba(255, 200, 61, 0.32);
  --glow-b: rgba(36, 87, 245, 0.16);
  --font-display: 'Chakra Petch', 'Trebuchet MS', system-ui, sans-serif;
  --font-body: 'Nunito', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0B1322;
    --surface: #141F38;
    --ink: #E9EFFA;
    --muted: #9FB0D0;
    --accent: #7C9BFF;
    --accent-ink: #0B1322;
    --coin: #FFC83D;
    --line: #8FA4D9;
    --shadow: #33477D;
    --grid: rgba(143, 164, 217, 0.1);
    --glow-a: rgba(255, 200, 61, 0.1);
    --glow-b: rgba(124, 155, 255, 0.18);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0B1322;
  --surface: #141F38;
  --ink: #E9EFFA;
  --muted: #9FB0D0;
  --accent: #7C9BFF;
  --accent-ink: #0B1322;
  --coin: #FFC83D;
  --line: #8FA4D9;
  --shadow: #33477D;
  --grid: rgba(143, 164, 217, 0.1);
  --glow-a: rgba(255, 200, 61, 0.1);
  --glow-b: rgba(124, 155, 255, 0.18);
  color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; }
body {
  background-color: var(--bg);
  /* kotak-kotak seperti buku tulis */
  background-image:
    linear-gradient(var(--grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 28px 28px;
  color: var(--ink);
  font: 400 1.0625rem/1.65 var(--font-body);
  padding-inline: 16px;
  padding-block: 20px 48px;
}
a { color: inherit; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

.wrap {
  max-width: 960px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  gap: 72px;
}

/* header */
.top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px 24px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font: 700 1.7rem/1 var(--font-display);
  text-decoration: none;
}
.brand::before {
  content: "";
  width: 16px;
  height: 16px;
  background: var(--coin);
  border: 3px solid var(--line);
}
.nav {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.nav a {
  display: inline-block;
  padding: 6px 10px;
  border: 2px solid transparent;
  font: 700 0.78rem/1.2 var(--font-mono);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
}
.nav a:hover { border-color: var(--line); background: var(--coin); color: #101B2D; }

/* hero */
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 32px;
  align-items: center;
}
.eyebrow {
  margin: 0 0 12px;
  font: 700 0.8rem/1.3 var(--font-mono);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
}
h1 {
  margin: 0 0 16px;
  font: 700 clamp(2.6rem, 9vw, 4.8rem)/1.05 var(--font-display);
  text-wrap: balance;
}
.cursor {
  display: inline-block;
  width: 0.5em;
  height: 0.13em;
  margin-left: 0.08em;
  background: var(--accent);
  animation: blink 1.1s steps(1) infinite;
}
@keyframes blink { 50% { opacity: 0; } }
.lead { margin: 0 0 24px; max-width: 34em; }
.actions { display: flex; flex-wrap: wrap; gap: 14px; }

.btn {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 8px 18px;
  border: 3px solid var(--line);
  background: var(--surface);
  color: var(--ink);
  box-shadow: 4px 4px 0 var(--shadow);
  font: 800 0.95rem/1.2 var(--font-body);
  text-decoration: none;
  cursor: pointer;
  transition: transform 0.08s, box-shadow 0.08s;
}
.btn:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--shadow); }
.btn:active { transform: translate(4px, 4px); box-shadow: 0 0 0 var(--shadow); }
.btn.main { background: var(--accent); color: var(--accent-ink); }
.btn.small { min-height: 38px; padding: 6px 14px; font-size: 0.88rem; }

.player {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 22px;
  background: var(--surface);
  border: 3px solid var(--line);
  box-shadow: 6px 6px 0 var(--shadow);
}
.player svg { display: block; max-width: 100%; height: auto; color: var(--accent); }
.player .coin { fill: var(--coin); }
.player .body { fill: var(--accent); }
.player-tag {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font: 700 0.74rem/1.3 var(--font-mono);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}

.avatar {
  margin: 0;
  width: 220px;
  max-width: 100%;
  background: #FFFFFF;
  border: 3px solid var(--line);
  box-shadow: 6px 6px 0 var(--shadow);
}
.avatar img { display: block; width: 100%; height: auto; }

/* section titles */
h2 {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 0 22px;
  font: 700 clamp(1.7rem, 5vw, 2.3rem)/1.1 var(--font-display);
}
h2::before {
  content: "";
  flex: none;
  width: 16px;
  height: 16px;
  background: var(--coin);
  border: 3px solid var(--line);
}

/* tentang */
.about {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
  gap: 32px;
  align-items: start;
}
.about p { margin: 0 0 14px; max-width: 34em; }
.sheet {
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 22px;
  background: var(--surface);
  border: 3px solid var(--line);
  box-shadow: 6px 6px 0 var(--shadow);
}
.sheet .row { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); align-items: baseline; gap: 12px; }
.sheet dt {
  font: 700 0.76rem/1.3 var(--font-mono);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}
.sheet dd { margin: 0; font: 600 1.15rem/1.3 var(--font-display); }

/* skill */
.skills {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}
.skill {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 16px 16px 20px;
  background: var(--surface);
  border: 3px solid var(--line);
  box-shadow: 5px 5px 0 var(--shadow);
}
.skill .icon {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 120px;
  padding: 6px;
  overflow: hidden;
  background: var(--logo-bg);
  border: 3px solid var(--line);
}
.skill .icon img { display: block; flex: none; width: auto; max-width: 100%; height: 100%; object-fit: contain; }
.skill .icon svg { display: block; max-width: 100%; height: auto; }
.skill .g { fill: var(--accent); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .skill .g { fill: #2457F5; } }
:root[data-theme="dark"] .skill .g { fill: #2457F5; }
.skill h3 { margin: 0; font: 700 1.35rem/1.2 var(--font-display); }
.skill p { margin: 0; color: var(--muted); font-size: 0.97rem; line-height: 1.5; }

/* projects */
.projects {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}
.project {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  min-width: 0;
  padding: 18px;
  background: var(--surface);
  color: var(--ink);
  border: 3px solid var(--line);
  box-shadow: 5px 5px 0 var(--shadow);
  text-decoration: none;
  transition: transform 0.08s, box-shadow 0.08s;
}
.project:hover { transform: translate(2px, 2px); box-shadow: 3px 3px 0 var(--shadow); }
.project .tag {
  padding: 2px 8px;
  background: var(--coin);
  color: #101B2D;
  border: 2px solid var(--line);
  font: 700 0.72rem/1.4 var(--font-mono);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.project h3 { margin: 0; font: 700 1.35rem/1.2 var(--font-display); }
.project p { margin: 0; flex: 1; color: var(--muted); font-size: 0.97rem; line-height: 1.5; }
.project .url { font: 500 0.82rem/1.4 var(--font-mono); color: var(--accent); overflow-wrap: anywhere; }

/* kontak */
.contact { display: grid; gap: 22px; }
.channel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px 20px;
  padding: 18px 20px;
  background: var(--surface);
  border: 3px solid var(--line);
  box-shadow: 6px 6px 0 var(--shadow);
}
.channel .label {
