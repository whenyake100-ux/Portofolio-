<script>
/* Huruf piksel 3x5 untuk ikon skill */
var GLYPH = {
  '<': ['..#', '.#.', '#..', '.#.', '..#'],
  '>': ['#..', '.#.', '..#', '.#.', '#..'],
  '/': ['..#', '..#', '.#.', '#..', '#..'],
  '{': ['.##', '.#.', '##.', '.#.', '.##'],
  '}': ['##.', '.#.', '.##', '.#.', '##.'],
  'J': ['.##', '..#', '..#', '#.#', '.#.'],
  'S': ['.##', '#..', '.#.', '..#', '##.'],
  'P': ['##.', '#.#', '##.', '#..', '#..'],
  'Y': ['#.#', '#.#', '.#.', '.#.', '.#.']
};
/* Sprite konsol game 16x8: # badan, o tombol */
var CONTROLLER = [
  '..############..',
  '.##############.',
  '###o########o###',
  '##ooo######o#o##',
  '###o########o###',
  '.######..######.',
  '.####......####.',
  '..##........##..'
];

function gridSvg(rows, classes, cell) {
  var h = rows.length, w = rows[0].length, rects = '';
  rows.forEach(function (row, y) {
    for (var x = 0; x < row.length; x++) {
      var cls = classes[row[x]];
      if (cls) rects += '<rect class="' + cls + '" x="' + x + '" y="' + y + '" width="1.02" height="1.02"/>';
    }
  });
  return '<svg viewBox="0 0 ' + w + ' ' + h + '" width="' + (w * cell) + '" height="' + (h * cell) +
    '" shape-rendering="crispEdges" focusable="false" aria-hidden="true">' + rects + '</svg>';
}

function glyphRows(text) {
  var rows = ['', '', '', '', ''];
  Array.from(text).forEach(function (ch, i) {
    var g = GLYPH[ch];
    for (var r = 0; r < 5; r++) rows[r] += (i ? '.' : '') + g[r];
  });
  return rows;
}

document.querySelectorAll('[data-glyph]').forEach(function (el) {
  el.innerHTML = gridSvg(glyphRows(el.getAttribute('data-glyph')), { '#': 'g' }, 9);
});

/* Tombol salin */
document.querySelectorAll('[data-copy]').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var el = document.getElementById(btn.getAttribute('data-copy'));
    var label = btn.textContent;
    function done(text) {
      btn.textContent = text;
      setTimeout(function () { btn.textContent = label; }, 2200);
    }
    function selectText() {
      var range = document.createRange();
      range.selectNodeContents(el);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
      done('Selected, copy it');
    }
    try {
      navigator.clipboard.writeText(el.textContent.trim()).then(
        function () { done('Copied'); },
        selectText
      );
    } catch (e) { selectText(); }
  });
});
</script>

