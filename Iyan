  font: 700 0.76rem/1.3 var(--font-mono);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}
.channel .value {
  margin: 0;
  font: 700 1.3rem/1.3 var(--font-display);
  overflow-wrap: anywhere;
  user-select: all;
}
.channel .buttons { display: flex; flex-wrap: wrap; gap: 10px; }
.channel .value.long { font: 500 0.92rem/1.5 var(--font-mono); }
.note { margin: 0; max-width: 40em; color: var(--muted); font-size: 0.95rem; line-height: 1.5; }

.foot {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8px 24px;
  padding-top: 20px;
  border-top: 3px solid var(--line);
  font: 500 0.78rem/1.5 var(--font-mono);
  color: var(--muted);
}

@media (max-width: 720px) {
  .wrap { gap: 56px; }
  .hero, .about { grid-template-columns: minmax(0, 1fr); }
  .avatar { order: -1; width: 150px; }
}
@media (max-width: 560px) {
  .channel { grid-template-columns: minmax(0, 1fr); }
}
@media (prefers-reduced-motion: reduce) {
  .cursor { animation: none; }
  .btn, .project { transition: none; }
}
</style>

